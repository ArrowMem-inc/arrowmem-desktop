{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArrowMem",
  "version": "0.1.0",
  "identifier": "ca.arrowmem.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/icon.png"],
    "externalBin": ["binaries/arrowbridge-companion"]
  }
}
