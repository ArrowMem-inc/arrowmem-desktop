#!/usr/bin/env bash
# Root helper for the ArrowBridge firewall rule. Installed read-only and owned by root; run via pkexec.
# Commands, and only these:
#   allow <cidr>   allow TCP 8788 from one private network (/16 to /30), tagged with the comment "arrowbridge"
#   remove         delete exactly the rules carrying that comment
# Exit codes: 0 done, 2 bad usage or bad CIDR, 3 ufw missing or inactive (nothing changed), 4 ufw failed.
HELPER_VERSION=1
set -u
# Fixed environment: pkexec already scrubs it, this makes it true however the helper is started. A translated
# "inactive" would break the status parse, so the locale is forced to C.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
UFW=/usr/sbin/ufw
PORT=8788
TAG=arrowbridge

die() { exit "$1"; }

# One RFC1918 network, prefix 16..30, no leading zeros, address must be the network address.
valid_cidr() {
  local c="$1" re='^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})/([1-9][0-9])$'
  [[ "$c" =~ $re ]] || return 1
  local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]} cc=${BASH_REMATCH[3]} d=${BASH_REMATCH[4]} p=${BASH_REMATCH[5]}
  (( a <= 255 && b <= 255 && cc <= 255 && d <= 255 )) || return 1
  (( p >= 16 && p <= 30 )) || return 1
  if (( a == 10 )); then :
  elif (( a == 172 && b >= 16 && b <= 31 )); then :
  elif (( a == 192 && b == 168 )); then :
  else return 1; fi
  local ip=$(( (a << 24) | (b << 16) | (cc << 8) | d ))
  local mask=$(( (0xFFFFFFFF << (32 - p)) & 0xFFFFFFFF ))
  (( (ip & mask) == ip )) || return 1
  return 0
}

ufw_active() {
  [ -x "$UFW" ] || return 1
  local s
  s=$("$UFW" status 2>/dev/null) || return 1
  [[ "$s" =~ ^Status:\ active ]]
}

case "${1:-}" in
  allow)
    [ "$#" -eq 2 ] || die 2
    valid_cidr "$2" || die 2
    ufw_active || die 3
    "$UFW" allow from "$2" to any port "$PORT" proto tcp comment "$TAG" >/dev/null 2>&1 || die 4
    ;;
  remove)
    [ "$#" -eq 1 ] || die 2
    ufw_active || die 3
    # Every delete uses a number from a listing read just before it, confirmed by a second read: the numbers shift
    # after each delete (and if something else edits the rules), so nothing is remembered between deletes.
    re='^\[[[:space:]]*([0-9]+)\][[:space:]].*[[:space:]]#[[:space:]]'"$TAG"'[[:space:]]*$'
    tagged() {  # prints tagged rule numbers, highest first
      local line
      while IFS= read -r line; do
        if [[ "$line" =~ $re ]]; then echo "${BASH_REMATCH[1]}"; fi
      done < <("$UFW" status numbered 2>/dev/null) | sort -rn
    }
    for ((guard=0; guard<200; guard++)); do
      n=$(tagged | head -n 1)
      [ -n "$n" ] || break
      tagged | grep -qx "$n" || continue   # it moved between the two reads: start again
      "$UFW" --force delete "$n" >/dev/null 2>&1 || die 4
    done
    [ -z "$(tagged | head -n 1)" ] || die 4
    ;;
  *) die 2 ;;
esac
exit 0
